#——————————————————————————————————————————————————————————————————————————————
# AfriBot - exemple de configuration
# 1. Copier ce fichier : cp .env.example .env
# 2. Remplir chaque variable (guide complet : docs/CONFIGURATION.md)
# 3. NE JAMAIS commiter le fichier .env
#——————————————————————————————————————————————————————————————————————————————

# --- Application ---
NODE_ENV=development
PORT=3001
APP_URL=https://tonbot.com
LOG_LEVEL=info
SESSION_TTL=1800

# --- PostgreSQL ---
# Variables Docker Compose (utilisees par services postgres + chatwoot)
POSTGRES_USER=afribot_user
# Mot de passe fort (> 20 caracteres) - generer avec : openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=afribot
# Bases supplementaires creees par scripts/init-db.sh au premier demarrage
POSTGRES_MULTIPLE_DATABASES=chatwoot_db
# DATABASE_URL - coherence avec POSTGRES_USER/PASSWORD/DB ci-dessus
# En Docker, l'hote est le nom du service : postgres
DATABASE_URL=postgresql://afribot_user:MOT_DE_PASSE@localhost:5432/afribot

# --- Redis ---
# Mot de passe Redis - generer avec : openssl rand -base64 24
REDIS_PASSWORD=
# En local sans auth : redis://localhost:6379/0
# En Docker (mot de passe injecte) : redis://:MOT_DE_PASSE@redis:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=afribot:

# --- Evolution API (Cloud API Meta officiel - OBLIGATOIRE, jamais Baileys) ---
EVOLUTION_API_URL=http://localhost:8080
# Cle API Evolution - generer depuis linterface dEvolution API
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=afribot-prod
# REGLE ABSOLUE : uniquement WHATSAPP-BUSINESS (Baileys = risque de ban)
INTEGRATION=WHATSAPP-BUSINESS
# Token de verification webhook - generer un token aleatoire securise
WA_BUSINESS_TOKEN_WEBHOOK=
# Variables Meta Cloud API (gerées cote Evolution API, pas utilisees par src/)
WA_BUSINESS_URL=https://graph.facebook.com
WA_BUSINESS_VERSION=v20.0
# URL du webhook externe vers Evolution API (serveur + n8n) - Docker uniquement
EVOLUTION_SERVER_URL=https://tonbot.com
AFRIBOT_WEBHOOK_URL=https://tonbot.com/webhook/messages

# --- Meta Cloud API (developers.facebook.com) ---
# Non utilise par le code src/ (les identifiants sont geres cote Evolution API) :
# META_PHONE_NUMBER_ID=123456789
# META_WHATSAPP_BUSINESS_ACCOUNT_ID=987654321
# META_ACCESS_TOKEN=EAABwzLexemple-remplacer-par-votre-token
# META_WEBHOOK_VERIFY_TOKEN=mon-token-secret

# --- Campagnes pub (CTWA + Broadcast) - anti-ban Meta ---
META_AD_ACCOUNT_ID=
# % de blocage avant pause automatique d'une campagne (REGLE META 4)
CAMPAIGN_MAX_BLOCK_RATE=2
# Messages/heure selon le tier Meta (Tier 0: 10 | Tier 1: 40 | Tier 2: 400)
CAMPAIGN_RATE_LIMIT_PER_HOUR=40
# true = pause automatique des campagnes si le score qualite passe en jaune
CAMPAIGN_PAUSE_ON_YELLOW=false

# --- Paiements CinetPay ---
CINETPAY_SITE_ID=
CINETPAY_API_KEY=
CINETPAY_NOTIFY_URL=https://tonbot.com/webhook/payment/cinetpay
CINETPAY_CURRENCY=XOF

# --- Paiements FedaPay (alternative) ---
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_ENVIRONMENT=sandbox

# --- Chatwoot (support humain) ---
CHATWOOT_URL=https://tonbot.com/chatwoot
# Generer : docker compose exec chatwoot-rails bundle exec rails secret
CHATWOOT_SECRET_KEY_BASE=
CHATWOOT_API_KEY=
CHATWOOT_INBOX_ID=1
CHATWOOT_ACCOUNT_ID=1

# --- Commerçant (notifications commandes/paiements) ---
# Identifiant du tenant (mono-commercant) - doit rester aligne sur le JWT 'admin'
MERCHANT_ID=admin
MERCHANT_NAME=Mon commerce
# Numero WhatsApp du commerchant, format international avec ou sans + (ex: +221771234567 ou 221771234567)
MERCHANT_PHONE=
# Horaires d'ouverture (Phase 6 - message ferme automatique) :
# laissez OPEN/CLOSE vides pour un bot 24/7. Ex : 8 et 20 (8h -> 20h).
# Une plage de nuit est supportee (ex : 22 et 6 = 22h -> 6h).
MERCHANT_TIMEZONE=Africa/Dakar
MERCHANT_OPEN_HOUR=
MERCHANT_CLOSE_HOUR=

# === MODES DE PAIEMENT ===

# --- MODE A - Cash a la livraison (COD) - TOUJOURS ACTIF ---
# Aucune API, aucun compte entreprise. Le livreur collecte l'argent puis
# confirme par WhatsApp (VALIDE <orderId>) -> commande LIVREE + payee.

# --- MODE B - Virement direct Wave / Orange Money / Moov ---
# Actif sans aggregateur : le client envoie l'argent sur votre numero puis
# colle son code de transaction. Vous validez par WhatsApp (VALIDER <id>).
# Ces numeros servent de valeurs par defaut de repli - ils sont modifiables
# depuis le dashboard (PUT /api/config), qui les stocke en base.
MERCHANT_WAVE_NUMBER=+22670000000
MERCHANT_ORANGE_NUMBER=+22674000000
MERCHANT_MOOV_NUMBER=+22676000000

# --- MODE C - PawaPay (aggregateur) - QUAND VOTRE ENTREPRISE EST CREEE ---
# Laisser PAWAPAY_API_TOKEN VIDE -> repli automatique sur le MODE B.
PAWAPAY_API_TOKEN=
PAWAPAY_ENVIRONMENT=sandbox

# --- n8n (automatisations) ---
N8N_URL=http://localhost:5678
N8N_API_KEY=
# Cle de chiffrement des credentials n8n (obligatoire en production)
# Generer : openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- Voix (Phase 6) - transcription message vocal ---
# DigiDays (primaire) et SmilGo (fallback)
DIGIDAYS_API_TOKEN=
SMILGO_ENDPOINT=
SMILGO_API_TOKEN=

#——————————————————————————————————————————————————————————————————————————————
# DASHBOARD COMMERCHANT (Phase 5 - authentification JWT)
# JWT_SECRET : minimum 32 caracteres. Generation :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#——————————————————————————————————————————————————————————————————————————————
JWT_SECRET=
JWT_EXPIRES_IN=7d
DASHBOARD_ADMIN_EMAIL=admin@tonbot.com
# Minimum 8 caracteres - utilise uniquement en local/dev
DASHBOARD_ADMIN_PASSWORD=

